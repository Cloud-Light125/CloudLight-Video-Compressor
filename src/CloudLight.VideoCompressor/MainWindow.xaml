                                            <TextBox Grid.Column="1"
                                                     Style="{StaticResource InputStyle}"
                                                     Text="{Binding Settings.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2"
                                                    Content="浏览…"
                                                    Command="{Binding BrowseOutputDirectoryCommand}"
                                                    Style="{StaticResource ActionButtonStyle}" />
                                        </Grid>
                                        <CheckBox Style="{StaticResource VisibleForSelectedDirectory}"
                                                  Content="保留原目录结构"
                                                  IsChecked="{Binding Settings.PreserveDirectoryStructure, Mode=TwoWay}"
                                                  Margin="112,8,0,0" />
                                        <Grid Style="{StaticResource VisibleForChildDirectory}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="子目录名称" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Grid.Column="1"
                                                     Style="{StaticResource InputStyle}"
                                                     Text="{Binding Settings.OutputSubdirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="原文件">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12">
                                <GroupBox Header="压缩成功后的源文件处理" Style="{StaticResource SectionGroupStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="处理方式" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  Style="{StaticResource SelectStyle}"
                                                  ItemsSource="{Binding OriginalFileActions}"
                                                  SelectedItem="{Binding Settings.OriginalFileAction, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="移动到目录" Style="{StaticResource FieldLabelStyle}" />
                                         <TextBox Grid.Row="1" Grid.Column="1"
                                                  Style="{StaticResource InputStyle}"
                                                  Text="{Binding Settings.OriginalFilesDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                         <Button Grid.Row="1" Grid.Column="2"
                                                 Content="浏览…"
                                                 Command="{Binding BrowseOriginalFilesDirectoryCommand}"
                                                 Style="{StaticResource ActionButtonStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="原目录子目录" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Style="{StaticResource InputStyle}"
                                                 Text="{Binding Settings.OriginalFilesSubdirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </GroupBox>
                                <Border Padding="10"
                                        Background="#FFF8E8"
                                        BorderBrush="#F0D38B"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="#795B16"
                                               Text="安全保护：只有 FFmpeg 成功、输出文件通过 ffprobe 验证且确认至少存在视频流、时长基本一致后，才会移动源文件。任务失败或取消时源文件保持不动。" />
                                </Border>
                                <CheckBox Margin="2,12,0,0"
                                          Content="如果压缩后文件比原文件更大，则放弃压缩结果"
                                          IsChecked="{Binding Settings.DiscardIfLarger, Mode=TwoWay}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="命名与性能">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12">
                                <GroupBox Header="压缩文件命名" Style="{StaticResource SectionGroupStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="输出前缀" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding Settings.OutputPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="输出后缀" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding Settings.OutputSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="原文件前缀" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding Settings.OriginalPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="原文件后缀" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource InputStyle}" Text="{Binding Settings.OriginalSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </GroupBox>
                                <TextBlock Margin="2,0,0,12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="扩展名始终保留在最后；同名文件会自动使用 (1)、(2)…，不会无提示覆盖。" />
                                <GroupBox Header="源文件健康检查" Style="{StaticResource SectionGroupStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="检查级别" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Grid.Column="1">
                                            <ComboBox Style="{StaticResource SelectStyle}"
                                                      ItemsSource="{Binding HealthCheckLevels}"
                                                      SelectedItem="{Binding Settings.HealthCheckLevel, Mode=TwoWay}" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Text="快速使用 ffprobe 检查视频流、时长和分辨率；深度会实际解码视频与音频到 null。默认快速，健康结果按源文件 fingerprint 缓存。" />
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                 <GroupBox Header="工具与并发" Style="{StaticResource SectionGroupStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="FFmpeg 工具目录" Style="{StaticResource FieldLabelStyle}" />
                                         <TextBox Grid.Row="0" Grid.Column="1"
                                                  Style="{StaticResource InputStyle}"
                                                  Text="{Binding Settings.FFmpegDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="留空时按软件目录、用户设置和 PATH 顺序查找 ffmpeg.exe / ffprobe.exe" />
                                         <Button Grid.Row="0" Grid.Column="2"
                                                 Content="浏览…"
                                                 Command="{Binding BrowseFfmpegCommand}"
                                                 Style="{StaticResource ActionButtonStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ffprobe 并发" Style="{StaticResource FieldLabelStyle}" />
                                        <DockPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock DockPanel.Dock="Right" Text="1 - 8" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding Settings.ProbeConcurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="压缩并发" Style="{StaticResource FieldLabelStyle}" />
                                        <DockPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock DockPanel.Dock="Right" Text="1 - 4（默认 1）" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBox Style="{StaticResource InputStyle}" Text="{Binding Settings.CompressionConcurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="性能模式" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Row="3" Grid.Column="1"
                                                  Style="{StaticResource SelectStyle}"
                                                  ItemsSource="{Binding PerformanceModes}"
                                                  SelectedItem="{Binding Settings.PerformanceMode, Mode=TwoWay}"
                                                  ToolTip="自动根据 CPU、系统内存和已验证的硬件编码能力选择稳妥策略。" />
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Text="自动：根据电脑和编码方式选择稳妥资源策略；低配置 / 长时间稳定：减少并发和后台竞争；平衡：兼顾响应与速度；速度优先：允许更高资源占用。"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                        <CheckBox Grid.Row="4" Grid.Column="2"
                                                  Content="压缩期间防止电脑自动睡眠"
                                                  VerticalAlignment="Center"
                                                  Margin="12,3,0,0"
                                                  IsChecked="{Binding Settings.PreventSleepDuringCompression, Mode=TwoWay}"
                                                  ToolTip="仅在任务运行期间保持系统唤醒，不阻止显示器关闭，不修改 Windows 电源计划。" />
                                    </Grid>
                                 </GroupBox>
                                 <GroupBox Header="编码性能参考" Style="{StaticResource SectionGroupStyle}">
                                     <StackPanel>
                                         <TextBlock Text="Benchmark 使用本机 FFmpeg 的合成测试画面，覆盖 1080p30 与 4K60；不会上传文件，也不会自动在启动时运行。结果用于解释 Auto 编码器选择。"
                                                    TextWrapping="Wrap"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Margin="0,0,0,8" />
                                         <DockPanel Margin="0,0,0,7">
                                             <Button DockPanel.Dock="Right"
                                                     Content="取消测试"
                                                     Command="{Binding CancelBenchmarkCommand}"
                                                     Style="{StaticResource DangerButtonStyle}" />
                                             <Button DockPanel.Dock="Right"
                                                     Content="测试本机编码性能"
                                                     Command="{Binding RunBenchmarkCommand}"
                                                     Style="{StaticResource PrimaryButtonStyle}" />
                                             <TextBlock Text="{Binding BenchmarkStatusDisplay}"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        Foreground="{StaticResource MutedTextBrush}" />
                                         </DockPanel>
                                         <ProgressBar Height="8"
                                                      Minimum="0"
                                                      Maximum="100"
                                                      Value="{Binding BenchmarkProgressPercent, Mode=OneWay}"
                                                      Margin="0,0,0,4" />
                                         <TextBlock Text="{Binding BenchmarkProgressDisplay}"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Margin="0,0,0,7" />
                                         <ItemsControl ItemsSource="{Binding BenchmarkRows}">
                                             <ItemsControl.ItemTemplate>
                                                 <DataTemplate>
                                                     <Grid Margin="0,2">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="230" />
                                                             <ColumnDefinition Width="*" />
                                                         </Grid.ColumnDefinitions>
                                                         <TextBlock Grid.Column="0"
                                                                    Text="{Binding DisplayName}"
                                                                    FontWeight="SemiBold" />
                                                         <TextBlock Grid.Column="1"
                                                                    Text="{Binding StatusDisplay}"
                                                                    TextWrapping="Wrap"
                                                                    Foreground="{StaticResource MutedTextBrush}" />
                                                     </Grid>
                                                 </DataTemplate>
                                             </ItemsControl.ItemTemplate>
                                         </ItemsControl>
                                     </StackPanel>
                                 </GroupBox>
                                 <GroupBox Header="全部任务完成后的操作" Style="{StaticResource SectionGroupStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="完成后" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox Grid.Column="1"
                                                      Style="{StaticResource SelectStyle}"
                                                      ItemsSource="{Binding CompletionActions}"
                                                      SelectedItem="{Binding Settings.CompletionAction, Mode=TwoWay}" />
                                        </Grid>
                                        <CheckBox Margin="112,8,0,0"
                                                  Content="有失败或取消时不执行睡眠、休眠或关机（推荐）"
                                                  IsChecked="{Binding Settings.DoNotPowerOffOnFailure, Mode=TwoWay}" />
                                        <CheckBox Margin="112,8,0,0"
                                                  Content="我确认已了解，所有任务结束后执行上面的操作"
                                                  IsChecked="{Binding Settings.CompletionActionConfirmed, Mode=TwoWay}" />
                                        <TextBlock Margin="112,6,0,0"
                                                   Foreground="#795B16"
                                                   TextWrapping="Wrap"
                                                   Text="睡眠、休眠和关机会在全部任务进入终态后执行，并在任务页提供 30 秒倒计时；首次选择危险操作时请确认。" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="历史记录">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="12">
                                <TextBlock Text="最近处理结果" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HistoryStatus}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,4,0,10" />
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="9"
                                                    Margin="0,0,0,8"
                                                    Background="#FAFBFC"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    ToolTip="{Binding SourceFile}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding FileNameDisplay}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding ResultDisplay}"
                                                                   Foreground="#1D4ED8"
                                                                   FontWeight="SemiBold"
                                                                   Margin="8,0,0,0" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding DateDisplay}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding PlannedEncoderDisplay, StringFormat=计划：{0}}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,5,0,0" />
                                                    <TextBlock Text="{Binding ActualEncoderDisplay, StringFormat=实际：{0}}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding BeforeSizeDisplay}" />
                                                        <TextBlock Text=" → " />
                                                        <TextBlock Text="{Binding AfterSizeDisplay}" />
                                                        <TextBlock Text=" · 节省 " />
                                                        <TextBlock Text="{Binding SavingDisplay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
