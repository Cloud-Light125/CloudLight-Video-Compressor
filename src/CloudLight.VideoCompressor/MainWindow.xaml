                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="编码格式" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox Grid.Column="1"
                                                      Style="{StaticResource SelectStyle}"
