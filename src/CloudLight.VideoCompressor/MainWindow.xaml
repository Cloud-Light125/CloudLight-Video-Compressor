                                </Border>
                                <DataGrid ItemsSource="{Binding Rules}"
                                          SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                          Style="{StaticResource VisibleWhenRulesExist}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          CanUserSortColumns="False"
                                          IsReadOnly="False"
                                          MinHeight="170"
                                          MaxHeight="330"
                                          BorderBrush="{StaticResource BorderBrush}"
                                          GridLinesVisibility="Horizontal"
                                          AlternationCount="2147483647"
                                          RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="启用"
                                                                Width="48"
                                                                Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <DataGridTemplateColumn Header="连接" Width="62">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBlock x:Name="FirstRuleJoin"
                                                                   Text="—"
                                                                   Visibility="Collapsed"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                        <ComboBox x:Name="JoinSelector"
                                                                  Style="{StaticResource SelectStyle}"
                                                                  ItemsSource="{Binding DataContext.RuleJoins, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                  SelectedItem="{Binding JoinWithPrevious, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=(ItemsControl.AlternationIndex)}" Value="0">
