<Window x:Class="CloudLight.VideoCompressor.CompressionTaskWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CloudLight.VideoCompressor.Models"
        Title="压缩任务"
        Width="1240"
        Height="820"
        MinWidth="1060"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#687384" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="#273142" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF4FF" />
                                <Setter Property="BorderBrush" Value="#9BB8F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DCE8FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#E9A6A0" />
        </Style>

        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="OptionalTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFallback}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Foreground" Value="#795B16" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFailureReason}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChangedValueStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#9A3412" />
                    <Setter Property="Background" Value="#FFF7ED" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChangeLabelStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#C2410C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ComparisonRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Parameter}"
                           Foreground="#4B5565"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1"
                           Text="{Binding OldValue}"
                           Style="{StaticResource ChangedValueStyle}"
                           TextAlignment="Right" />
                <TextBlock Grid.Column="2"
                           Text="→"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#9CA3AF"
                           FontSize="15" />
                <TextBlock Grid.Column="3"
                           Text="{Binding NewValue}"
                           Style="{StaticResource ChangedValueStyle}" />
                <TextBlock Grid.Column="4"
                           Text="{Binding ChangeDisplay}"
                           Style="{StaticResource ChangeLabelStyle}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EntryDetailsTemplate">
            <StackPanel>
                <TextBlock Text="压缩前 → 压缩后计划"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="压缩前" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="压缩后计划" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Grid.Column="4" Text="变化" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Comparison.Parameters}"
                              ItemTemplate="{StaticResource ComparisonRowTemplate}" />

                <GroupBox Header="压缩决策" Margin="0,16,0,0" Padding="10,8" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding DecisionReasonDisplay}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SmartExplanationDisplay}"
                                   Visibility="{Binding HasSmartExplanation, Converter={StaticResource BoolToVisibility}}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="计划输出" Margin="0,12,0,0" Padding="10,8" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding OutputPath}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResultSizeDisplay}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding PlannedSavingDisplay}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="实际结果" Margin="0,12,0,0" Padding="10,8" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="状态" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExecutionStateDisplay}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="实际编码器" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActualEncoderDisplay}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="实际视频编码" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActualVideoCodecDisplay}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="实际码率" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ActualVideoBitrateDisplay}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="实际分辨率 / FPS" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActualResolutionFpsDisplay}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="实际文件大小 / 节省" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ActualSizeSavingDisplay}" Margin="0,5,0,0" />
                    </Grid>
                </GroupBox>
                <Border Background="#FFF8E8"
                        BorderBrush="#F0D38B"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="9"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasFallback, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding FallbackReason}" TextWrapping="Wrap" Foreground="#795B16" />
                </Border>
                <Border Background="#FFF1F0"
                        BorderBrush="#E9A6A0"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="9"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasFailureReason, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding FailureReasonDisplay}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="压缩任务" FontSize="24" FontWeight="SemiBold" Foreground="#172033" />
                <TextBlock Text="{Binding OverallStatusDisplay}"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="620" />
        </DockPanel>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="14,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="待压缩视频" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock Text="{Binding TotalCount, StringFormat={}{0} 个}" Style="{StaticResource SummaryValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="源文件总大小" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock Text="{Binding SourceTotalSizeDisplay}" Style="{StaticResource SummaryValueStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="预计输出大小" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock Text="{Binding OutputTotalSizeDisplay}" Style="{StaticResource SummaryValueStyle}" FontSize="16" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="预计节省" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock Text="{Binding SavingDisplay}" Style="{StaticResource SummaryValueStyle}" FontSize="16" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="编码方式（计划）" Style="{StaticResource SummaryLabelStyle}" />
                    <TextBlock Text="{Binding EncodingSummaryDisplay}"
                               Style="{StaticResource SummaryValueStyle}"
                               FontSize="14"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#EAF2FF"
                BorderBrush="#C9DAFF"
                BorderThickness="1"
                CornerRadius="7"
                Padding="14,11"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Left" Text="任务进度" Foreground="#1E3A8A" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding OverallProgressDisplay}" Foreground="#1E3A8A" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TaskProgressDisplay}" Foreground="#334A7D" Margin="10,0,0,0" />
                </DockPanel>
                <ProgressBar Grid.Row="1"
                             Height="10"
                             Margin="0,9,0,7"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding OverallProgressPercent, Mode=OneWay}" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2.2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CompletedCount, StringFormat=已完成 {0}}" Foreground="#334A7D" />
                    <TextBlock Grid.Column="1" Text="{Binding CompressingCount, StringFormat=处理中 {0}}" Foreground="#334A7D" />
                    <TextBlock Grid.Column="2" Text="{Binding QueuedCount, StringFormat=排队 {0}}" Foreground="#334A7D" />
                    <TextBlock Grid.Column="3" Text="{Binding WaitingCount, StringFormat=等待 {0}}" Foreground="#334A7D" />
                    <TextBlock Grid.Column="4" Text="{Binding FailedCount, StringFormat=失败 {0}}" Foreground="#334A7D" />
                    <TextBlock Grid.Column="5" Text="{Binding CurrentTaskDisplay, StringFormat=当前任务：{0}}" Foreground="#334A7D" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" MinWidth="430" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.25*" MinWidth="470" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="13,11,13,7">
                        <TextBlock Text="处理计划" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalCount, StringFormat= · {0} 个最终处理视频}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="White"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="8,3" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EEF4FF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11,10"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding ExecutionStateDisplay}"
                                                       Foreground="#1D4ED8"
                                                       FontWeight="SemiBold"
                                                       Margin="10,0,0,0" />
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding PlannedEncoderDisplay}" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                            <TextBlock Text="{Binding PlannedEncoderIdDisplay}" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding PlannedEncoderKindDisplay}" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <ProgressBar Grid.Row="2"
                                                     Height="8"
                                                     Margin="0,9,0,3"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}" />
                                        <DockPanel Grid.Row="3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressDisplay}" Foreground="#4B5565" />
                                            <TextBlock Text="{Binding ResultSizeDisplay}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Grid.Row="4"
                                                   Text="{Binding PlannedSavingDisplay}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,4,0,0" />
                                        <StackPanel Grid.Row="5">
                                            <TextBlock Text="{Binding StatusDetail}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,7,0,0"
                                                       MaxHeight="42" />
                                            <TextBlock Text="{Binding FallbackReason, StringFormat=编码回退：{0}}"
                                                       Style="{StaticResource OptionalTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ContentControl Content="{Binding SelectedEntry}"
                                        ContentTemplate="{StaticResource EntryDetailsTemplate}" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,1,1,0"
                Padding="0,12,0,0"
                Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="返回"
                            Command="{Binding ReturnCommand}"
                            IsEnabled="{Binding CanReturn}"
                            Style="{StaticResource BaseButtonStyle}"
                            MinWidth="82" />
                    <Button Content="停止"
                            Command="{Binding StopCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                            MinWidth="82" />
                    <Button Content="开始压缩"
                            Command="{Binding StartCompressionCommand}"
                            IsEnabled="{Binding CanStart}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="110" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FinalSummaryDisplay}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ActualOutputTotalSizeDisplay, StringFormat= · 实际输出 {0}}" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
